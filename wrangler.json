{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mojji",
  "account_id": "93300edc910b267d9a3f0efd51bf600d",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "mojji.haklee.me",
      "custom_domain": true
    },
    {
      "pattern": "slackmoji.haklee.me",
      "custom_domain": true
    },
    {
      "pattern": "slackmojji.haklee.me",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mojji-gallery",
      "database_id": "c20a5c95-7c7b-4973-9fb4-f021ca5851a7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MOCHI",
      "bucket_name": "mojji-gallery"
    }
  ],
  "main": "src/server/worker.ts",
  "ratelimits": [
    {
      "name": "PUBLISH_LIMIT",
      "namespace_id": "12801",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DOWNLOAD_LIMIT",
      "namespace_id": "12802",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
